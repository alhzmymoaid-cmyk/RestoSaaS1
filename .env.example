# ============================================================================
# إعدادات بيئة العمل لنظام المطاعم المتعدد (Next.js + Supabase)
# تنبيه أمني: لا تضع أبداً مفتاح SUPABASE_SERVICE_ROLE_KEY في متغيرات NEXT_PUBLIC_
# ============================================================================

# رابط مشروع Supabase الخاص بك (آمن للواجهة الأمامية مع تفعيل سياسات RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# المفتاح العام (Anon Public Key) الخاضع لسياسات RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# مفتاح الخدمة السري للخادم فقط (Server-only - لا يظهر أبداً في المتصفح)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# اسم حاوية التخزين للصور في Supabase Storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=restaurant-media

# الرابط الأساسي للمنصة على Vercel أو النطاق المخصص
NEXT_PUBLIC_SITE_URL=http://localhost:3000
